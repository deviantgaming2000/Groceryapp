# Docker/server settings
POSTGRES_DB=grocery_price_checker
POSTGRES_USER=grocery
POSTGRES_PASSWORD=change_this_password
APP_PORT=8080
SINGLE_USER_EMAIL=local@example.com

# Leave blank when frontend and backend are served from the same container stack.
VITE_API_BASE=

# Optional. If unset, distance can be entered manually and the app still works.
GOOGLE_MAPS_API_KEY=

# Optional. Kroger / Fry's product API (https://developer.kroger.com). Backend-only — never
# exposed to the frontend. If unset, manual product entry still works; API search is disabled.
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=
# Defaults are fine for production. Override only if needed.
# KROGER_API_BASE=https://api.kroger.com
# KROGER_OAUTH_SCOPE=product.compact

# Optional. Walmart has no open API — product search runs through SerpApi's Walmart engine
# (https://serpapi.com/walmart-product-api). Can also be set in-app under Settings → API Keys.
SERPAPI_KEY=

# All of the above can be entered/updated in the web app (Settings → API Keys) instead of here.
# Keys set in the app are stored in the database and take precedence over these env values.

# Local non-Docker backend development uses this URL.
DATABASE_URL="postgresql://grocery:change_this_password@localhost:5432/grocery_price_checker?schema=public"
PORT=4000
